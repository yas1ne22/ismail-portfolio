{
  "name": "ismail-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "node scripts/render-legacy-routes.mjs && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "node --test tests/*.test.mjs",
    "verify:portfolio": "node scripts/check-contrast.mjs && node scripts/check-fragments.mjs && python3 scripts/verify-portfolio.py",
    "prepare:cases": "node scripts/prepare-portfolio.mjs"
  },
  "dependencies": {
    "lucide": "^1.72.0",
    "lucide-static": "^1.72.0",
    "three": "^0.180.0",
    "vite": "^6.4.1"
  },
  "devDependencies": {
    "linkedom": "^0.18.13"
  }
}
